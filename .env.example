# ==============================================================================
# Thermal IR Image Enhancement & Colorization System - Configuration
# ==============================================================================

# AI Inference Provider: 'pytorch_pix2pix' (local trained model) or 'local' (colormap)
AI_PROVIDER=pytorch_pix2pix


# Server & Network Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
REQUEST_TIMEOUT_SECONDS=60

# Security & Upload Constraints
MAX_UPLOAD_SIZE_MB=15

# Default Preprocessing Parameters
CLAHE_CLIP_LIMIT=2.0
CLAHE_GRID_SIZE=8
BILATERAL_D=9
BILATERAL_SIGMA_COLOR=75.0
BILATERAL_SIGMA_SPACE=75.0

# Default Post-Processing Parameters
UNSHARP_RADIUS=1.5
UNSHARP_AMOUNT=1.2
UNSHARP_THRESHOLD=3

# Optional: Microsoft Planetary Computer Subscription Key (for increased rate limits)
# PC_SDK_SUBSCRIPTION_KEY=

